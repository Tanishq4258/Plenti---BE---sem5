# Plenti Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace with your MongoDB Atlas or local MongoDB URI)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/plenti_db?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/plenti_db
MONGO_URI=mongodb://127.0.0.1:27017/plenti_db

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=plenti_super_secure_jwt_secret_key_2026_xyz987

# Token Expiry (e.g. 7d, 24h)
JWT_EXPIRE=7d
